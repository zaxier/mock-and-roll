# Environment Configuration Example
# Copy this file to .env.local and customize values as needed
# The CLI reads standard Databricks env vars.
# If you use this file, load it before running commands:
#   set -a; source .env.local; set +a

# ===== DATABRICKS CONFIGURATION =====
# Databricks CLI profile used by databricks-connect session creation
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Optional direct auth variables (only if not using profile-based auth)
# DATABRICKS_HOST=https://<your-workspace-host>
# DATABRICKS_TOKEN=<your-personal-access-token>

# Optional defaults you can reuse in shell commands / Makefile
CATALOG=dev
SCHEMA=sandbox
